# INVOSTRATA Enterprise Environment Configuration
# Copy this file to .env and adjust as necessary for production deployments.

# Project Identity
PROJECT_NAME="INVOSTRATA"
PROJECT_TITLE="Automated Invoice Validation & Financial Consistency Workstation"
VERSION="1.0.0"

# Database Configuration
# Default: Local SQLite (zero-config, high-performance out-of-the-box local operation)
DATABASE_URL="sqlite:///./invostrata.db"

# For PostgreSQL in enterprise production:
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/invostrata"

# Security & JWT Token Key
SECRET_KEY="invostrata_enterprise_financial_consistency_secret_2026"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# Financial Validation Parameters
ROUNDING_TOLERANCE=0.05
MAX_INVOICE_AGE_DAYS=180
HIGH_DISCOUNT_PERCENT=20.0
ROUND_NUMBER_MODULO=1000.0
